<!-- WHY SSIM -->
<section class="py-12 md:py-16 px-4 md:px-10">
  <div class="max-w-6xl mx-auto">
    <div class="mb-8 md:mb-10 reveal">
      <p class="text-xs font-bold uppercase tracking-widest text-gold mb-2">Why Choose SSIM</p>
      <h2 class="font-display text-2xl md:text-4xl font-extrabold text-navy mb-3">Everything You Need to Build a Winning Career</h2>
      <p class="text-gray-500 text-sm md:text-base leading-relaxed max-w-xl">SSIM combines 35+ years of management expertise with industry-aligned curriculum, stellar faculty, and a powerful alumni network.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      <div class="reveal bg-white border border-gray-200 rounded-xl p-5 hover:shadow-lg hover:-translate-y-1 transition-all group relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-navy to-gold opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="w-11 h-11 bg-navy rounded-xl flex items-center justify-center text-xl mb-4">🏆</div>
        <h3 class="text-sm md:text-base font-bold text-navy mb-2">Top Ranked B-School</h3>
        <p class="text-xs md:text-sm text-gray-500 leading-relaxed">Ranked 21st among Private B-Schools in India (Outlook 2025) and 2nd in Telangana. Recognised as A+++ by Business India 2024.</p>
      </div>
      <div class="reveal bg-white border border-gray-200 rounded-xl p-5 hover:shadow-lg hover:-translate-y-1 transition-all group relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-navy to-gold opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="w-11 h-11 bg-navy rounded-xl flex items-center justify-center text-xl mb-4">📚</div>
